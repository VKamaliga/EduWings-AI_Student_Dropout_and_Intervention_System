# EduWings Backend Environment Variables
PORT=5001
NODE_ENV=development

# Database Connection (MongoDB Atlas connection string for production)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/eduwings?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/eduwings

# Authentication
JWT_SECRET=your_super_secure_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Allowed Frontend Client Origin for CORS
# In production, set to your Vercel deployment URL (e.g. https://eduwings-client.vercel.app)
CLIENT_URL=http://localhost:5173

# ML Service URL (Render service URL in production, local in dev)
# Example: https://eduwings-ml.onrender.com
ML_SERVICE_URL=http://127.0.0.1:8000
